FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y \
    curl gnupg2 lsb-release locales sudo \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
  -o /usr/share/keyrings/ros-archive-keyring.gpg

RUN echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
  > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash ros && echo "ros ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
USER ros

WORKDIR /workspaces/mars-rover-prop-m-blueprint
COPY --chmod=755 infrastructure/docker/scripts/entrypoint_ros.sh /entrypoint_ros.sh
ENTRYPOINT ["/entrypoint_ros.sh"]
CMD ["bash"]
